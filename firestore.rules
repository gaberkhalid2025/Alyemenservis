rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnerOrAdmin() {
      return isSignedIn() && (
        request.auth.token.role in ['SUPER_ADMIN', 'MAIN_ADMIN', 'OWNER', 'ADMIN', 'owner', 'admin']
      );
    }

    function isStaff() {
      return isSignedIn() && (
        request.auth.token.role in ['SUPER_ADMIN', 'MAIN_ADMIN', 'OWNER', 'ADMIN', 'SUPERVISOR', 'owner', 'admin', 'supervisor']
      );
    }

    function matchesOwner(data) {
      return isSignedIn() && (
        (('ownerId' in data) && data.ownerId == request.auth.uid) ||
        (('ownerUid' in data) && data.ownerUid == request.auth.uid) ||
        (('providerId' in data) && data.providerId == request.auth.uid) ||
        (('storeId' in data) && data.storeId == request.auth.uid) ||
        (('entityId' in data) && data.entityId == request.auth.uid) ||
        (('userId' in data) && data.userId == request.auth.uid) ||
        (('uid' in data) && data.uid == request.auth.uid) ||
        (('id' in data) && data.id == request.auth.uid) ||
        (('email' in request.auth.token) && request.auth.token.email is string && (
          (('phone' in data) && data.phone is string && request.auth.token.email == (data.phone + '@yemen-services.app')) ||
          (('ownerId' in data) && data.ownerId is string && request.auth.token.email == (data.ownerId + '@yemen-services.app')) ||
          (('providerId' in data) && data.providerId is string && request.auth.token.email == (data.providerId + '@yemen-services.app')) ||
          (('storeId' in data) && data.storeId is string && request.auth.token.email == (data.storeId + '@yemen-services.app'))
        ))
      );
    }

    // 1. المتاجر ومزودي الخدمات والعقارات والمنتجات والمعارض والأطباء والعروض والأقسام والمدن والبانرات
    match /stores/{d} {
      allow read: if true;
      allow create, delete: if isStaff();
      allow update: if isStaff() || matchesOwner(resource.data);
    }
    match /providers/{d} {
      allow read: if true;
      allow create, delete: if isStaff();
      allow update: if isStaff()
                  || matchesOwner(resource.data)
                  || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'numReviews']);
    }
    match /properties/{d} {
      allow read: if true;
      allow create, delete: if isStaff();
      allow update: if isStaff() || matchesOwner(resource.data);
    }
    match /products/{productId} {
      allow read: if true;
      allow create: if isSignedIn() && (isStaff() || matchesOwner(request.resource.data));
      allow update, delete: if isStaff() || matchesOwner(resource.data);
    }
    match /galleries/{itemId} {
      allow read: if true;
      allow create: if isSignedIn() && (isStaff() || matchesOwner(request.resource.data));
      allow update, delete: if isStaff() || matchesOwner(resource.data);
    }
    match /doctors/{doctorId} {
      allow read: if true;
      allow create: if isSignedIn() && (isStaff() || matchesOwner(request.resource.data));
      allow update, delete: if isStaff() || matchesOwner(resource.data);
    }
    match /special_offers/{offerId} {
      allow read: if true;
      allow create: if isSignedIn() && (isStaff() || matchesOwner(request.resource.data));
      allow update, delete: if isStaff() || matchesOwner(resource.data);
    }
    match /offers/{d} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isStaff() || matchesOwner(resource.data);
    }
    match /{path=**}/offers/{offerId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isStaff() ||
        matchesOwner(resource.data) ||
        (('requestId' in resource.data) && resource.data.requestId is string &&
          matchesOwner(get(/databases/$(db)/documents/instant_requests/$(resource.data.requestId)).data))
      );
      allow delete: if isStaff() || matchesOwner(resource.data);
    }
    match /coupons/{couponId} {
      allow read: if true;
      allow create: if isSignedIn() && (isStaff() || matchesOwner(request.resource.data));
      allow update, delete: if isStaff() || matchesOwner(resource.data);
    }
    match /loyalty_programs/{programId} {
      allow read: if true;
      allow create: if isSignedIn() && (isStaff() || matchesOwner(request.resource.data));
      allow update, delete: if isStaff() || matchesOwner(resource.data);
    }
    match /inventory/{itemId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (isStaff() || matchesOwner(request.resource.data));
      allow update, delete: if isStaff() || matchesOwner(resource.data);
    }
    match /staff/{staffId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (isStaff() || matchesOwner(request.resource.data));
      allow update, delete: if isStaff() || matchesOwner(resource.data);
    }
    match /categories/{d} {
      allow read: if true;
      allow write: if isStaff();
    }
    match /cities/{d} {
      allow read: if true;
      allow write: if isStaff();
    }
    match /banners/{d} {
      allow read: if true;
      allow write: if isStaff();
    }
    match /custom_profile_tabs/{d} {
      allow read: if true;
      allow write: if isStaff();
    }
    match /color_themes/{d} {
      allow read: if true;
      allow write: if isStaff();
    }
    match /ai_guides/{d} {
      allow read: if true;
      allow write: if isStaff();
    }
    match /payment_wallets/{d} {
      allow read: if true;
      allow write: if isOwnerOrAdmin();
    }
    match /payment_gateways/{d} {
      allow read: if true;
      allow write: if isOwnerOrAdmin();
    }
    match /quick_service_settings/{d} {
      allow read: if true;
      allow write: if isOwnerOrAdmin();
    }
    match /app_settings/{d} {
      allow read: if true;
      allow write: if isOwnerOrAdmin();
    }

    // 2. طلبات الانضمام المعلقة والوظائف
    match /join_requests/{d} {
      allow read: if isStaff() || (isSignedIn() && (resource.data.uid == request.auth.uid || resource.data.userId == request.auth.uid || matchesOwner(resource.data)));
      allow create: if isSignedIn();
      allow update, delete: if isStaff();
    }
    match /pending_providers/{d} {
      allow read: if isStaff() || (isSignedIn() && (resource.data.ownerId == request.auth.uid || matchesOwner(resource.data)));
      allow create: if isSignedIn();
      allow update, delete: if isStaff();
    }
    match /jobs/{d} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isStaff() || matchesOwner(resource.data);
    }
    match /job_listings/{d} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isStaff() || matchesOwner(resource.data);
    }
    match /job_applications/{d} {
      allow read, create: if isSignedIn();
      allow update, delete: if isStaff() || matchesOwner(resource.data);
    }
    match /job_seekers/{d} {
      allow read, create: if isSignedIn();
      allow update, delete: if isStaff() || matchesOwner(resource.data);
    }

    // 3. مستخدمي الإدارة والمالك والمشرفين والأسرار (ممنوع الوصول السحابي المباشر منعاً تاماً)
    match /admin_users/{d} { allow read, write: if false; }
    match /admins/{d} { allow read, write: if false; }
    match /supervisors/{d} { allow read, write: if false; }
    match /admin_secrets/{d} { allow read, write: if false; }

    // 4. المستخدمين المسجلين والمفضلة (حماية تصعيد الصلاحيات)
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isStaff());
      allow create: if isSignedIn() && (
        isStaff() || (
          request.auth.uid == userId &&
          (!('role' in request.resource.data) || !(request.resource.data.role in ['ADMIN', 'OWNER', 'SUPER_ADMIN', 'MAIN_ADMIN', 'admin', 'owner']))
        )
      );
      allow update: if isSignedIn() && (
        isStaff() || (
          request.auth.uid == userId &&
          (!('role' in request.resource.data) || request.resource.data.role == resource.data.role) &&
          !(request.resource.data.role in ['ADMIN', 'OWNER', 'SUPER_ADMIN', 'MAIN_ADMIN', 'admin', 'owner'])
        )
      );
      allow delete: if isStaff();

      match /favorites/{favId} {
        allow read, write: if isSignedIn() && (
          request.auth.uid == userId ||
          (('email' in request.auth.token) && request.auth.token.email is string && request.auth.token.email == (userId + '@yemen-services.app')) ||
          isStaff()
        );
      }
    }
    match /favorites/{favId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isSignedIn() && (isStaff() || matchesOwner(resource.data));
    }
    match /registered_users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isStaff());
      allow create: if isSignedIn() && (
        isStaff() || (
          request.auth.uid == userId &&
          (!('role' in request.resource.data) || !(request.resource.data.role in ['ADMIN', 'OWNER', 'SUPER_ADMIN', 'MAIN_ADMIN', 'admin', 'owner']))
        )
      );
      allow update, delete: if isStaff();
    }

    // 5. الإعدادات العامة (قراءة للمستخدمين المسجلين عدا الأسرار، وتعديل للإدارة والمالك فقط)
    match /settings/{d} {
      allow read: if d != 'admin_secrets' && isSignedIn();
      allow write: if isOwnerOrAdmin();
    }

    // 6. استعادة الحسابات وكلمات المرور
    match /password_resets/{d} {
      allow read, update, delete: if isStaff();
      allow create: if isSignedIn();
    }
    match /password_recovery_requests/{d} {
      allow read, update, delete: if isStaff();
      allow create: if isSignedIn();
    }
    match /account_recovery_requests/{d} {
      allow read, update, delete: if isStaff();
      allow create: if isSignedIn();
    }

    // 7. الحجوزات والطلبات والمواعيد والمحافظ والإشعارات
    match /bookings/{bookingId} {
      allow read: if isSignedIn() && (
        isStaff() ||
        resource.data.clientId == request.auth.uid ||
        resource.data.providerId == request.auth.uid ||
        resource.data.customerPhone == request.auth.uid ||
        resource.data.providerPhone == request.auth.uid ||
        matchesOwner(resource.data)
      );
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (
        isStaff() ||
        resource.data.clientId == request.auth.uid ||
        resource.data.providerId == request.auth.uid ||
        matchesOwner(resource.data)
      );
    }
    match /instant_requests/{d} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isStaff() ||
        matchesOwner(resource.data) ||
        (('acceptedTechnicianId' in resource.data) && resource.data.acceptedTechnicianId == request.auth.uid) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['offersCount', 'updatedAt'])
      );
      allow delete: if isStaff() || matchesOwner(resource.data);

      match /offers/{offerId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update: if isSignedIn() && (
          isStaff() ||
          matchesOwner(resource.data) ||
          matchesOwner(get(/databases/$(db)/documents/instant_requests/$(d)).data)
        );
        allow delete: if isStaff() || matchesOwner(resource.data);
      }
    }
    match /urgent_requests/{d} {
      allow read, create: if isSignedIn();
      allow update, delete: if isStaff() || matchesOwner(resource.data);
    }
    match /service_requests/{d} {
      allow read, create: if isSignedIn();
      allow update, delete: if isStaff() || matchesOwner(resource.data);
    }
    match /request_offers/{d} {
      allow read, create: if isSignedIn();
      allow update: if isSignedIn() && (
        isStaff() ||
        matchesOwner(resource.data) ||
        (('requestId' in resource.data) && resource.data.requestId is string &&
          matchesOwner(get(/databases/$(db)/documents/instant_requests/$(resource.data.requestId)).data))
      );
      allow delete: if isStaff() || matchesOwner(resource.data);
    }
    match /orders/{orderId} {
      allow read: if isSignedIn() && (
        isStaff() ||
        resource.data.userId == request.auth.uid ||
        resource.data.customerPhone == request.auth.uid ||
        resource.data.storeId == request.auth.uid ||
        matchesOwner(resource.data)
      );
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (
        isStaff() ||
        resource.data.userId == request.auth.uid ||
        resource.data.storeId == request.auth.uid ||
        matchesOwner(resource.data)
      );
    }
    match /store_orders/{orderId} {
      allow read: if isSignedIn() && (
        isStaff() ||
        resource.data.userId == request.auth.uid ||
        resource.data.customerPhone == request.auth.uid ||
        resource.data.storeId == request.auth.uid ||
        matchesOwner(resource.data)
      );
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (
        isStaff() ||
        resource.data.userId == request.auth.uid ||
        resource.data.storeId == request.auth.uid ||
        matchesOwner(resource.data)
      );
    }
    match /appointments/{d} {
      allow read, write: if isSignedIn();
    }
    match /medical_appointments/{d} {
      allow read, write: if isSignedIn();
    }
    match /notifications/{notifId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isStaff() || resource.data.targetValue == request.auth.uid
      );
      allow delete: if isStaff() || (
        isSignedIn() && resource.data.targetValue == request.auth.uid
      );
    }
    match /payments/{d} {
      allow read, create: if isSignedIn();
      allow update, delete: if isStaff() || matchesOwner(resource.data);
    }
    match /payment_transactions/{d} {
      allow read: if isSignedIn() && (isStaff() || matchesOwner(resource.data));
      allow create: if isSignedIn();
      allow update, delete: if isStaff();
    }
    match /wallets/{d} {
      allow read: if isSignedIn() && (isStaff() || d == request.auth.uid || d == ('wallet_' + request.auth.uid) || (resource != null && matchesOwner(resource.data)));
      allow write: if isStaff();
    }
    match /wallet_topups/{topupId} {
      allow read: if isSignedIn() && (isStaff() || resource.data.userId == request.auth.uid || resource.data.walletId == ('wallet_' + request.auth.uid) || matchesOwner(resource.data));
      allow create: if isSignedIn() &&
        request.resource.data.status == 'PENDING' &&
        request.resource.data.amount is number &&
        request.resource.data.amount > 0;
      allow update, delete: if isStaff();
    }
    match /internal_wallets/{d} {
      allow read: if isSignedIn() && (isStaff() || d == request.auth.uid || matchesOwner(resource.data));
      allow create: if isSignedIn();
      allow update, delete: if isStaff();
    }
    match /wallet_transactions/{txId} {
      allow read: if isSignedIn() && (
        isStaff() ||
        resource.data.walletId == request.auth.uid ||
        resource.data.walletId == ('wallet_' + request.auth.uid) ||
        resource.data.userId == request.auth.uid
      );
      allow create, update, delete: if isStaff();
    }
    match /transactions/{d} {
      allow read, create: if isSignedIn();
      allow update, delete: if isStaff();
    }

    // 8. المحادثات والرسائل والتواجد والإشعارات
    match /chat_channels/{channelId} {
      allow read: if isSignedIn() && (
        isStaff() || request.auth.uid in resource.data.participants
      );
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (
        isStaff() || request.auth.uid in resource.data.participants
      );

      match /messages/{msgId} {
        allow read: if isSignedIn() && (
          isStaff() ||
          request.auth.uid in get(/databases/$(db)/documents/chat_channels/$(channelId)).data.participants
        );
        allow create: if isSignedIn() && (
          isStaff() ||
          request.auth.uid in get(/databases/$(db)/documents/chat_channels/$(channelId)).data.participants
        );
        allow update: if isSignedIn() && (
          isStaff() ||
          request.auth.uid in get(/databases/$(db)/documents/chat_channels/$(channelId)).data.participants
        );
        allow delete: if isStaff() || (
          isSignedIn() && resource.data.senderId == request.auth.uid
        );
      }
    }
    match /chat_rooms/{roomId} {
      allow read, write: if isSignedIn();
      match /messages/{msgId} {
        allow read, write: if isSignedIn();
      }
    }
    match /chats/{chatId} {
      allow read, write: if isSignedIn() && (request.auth.uid in resource.data.participants || isStaff());
      match /messages/{msgId} {
        allow read, write: if isSignedIn() && (
          request.auth.uid in get(/databases/$(db)/documents/chats/$(chatId)).data.participants || isStaff()
        );
      }
    }
    match /presence/{d} {
      allow read, write: if isSignedIn();
    }
    match /user_presence/{d} {
      allow read, write: if isSignedIn();
    }
    match /fcm_tokens/{d} {
      allow read, write: if isSignedIn();
    }
    match /devices/{d} {
      allow read, write: if isSignedIn();
    }

    // 9. التقييمات والمراجعات والبلاغات والخدمات المساندة
    match /reviews/{d} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    match /ratings/{d} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isSignedIn()
                && (resource.data.userId == request.auth.uid
                    || isOwnerOrAdmin());
    }
    match /reports/{d} {
      allow create: if isSignedIn();
      allow read, update, delete: if isStaff();
    }
    match /review_reports/{d} {
      allow create: if isSignedIn();
      allow read, update, delete: if isStaff();
    }
    match /coming_soon_subscribers/{d} {
      allow read, write: if isSignedIn();
    }
    match /ai_assistant_sessions/{d} {
      allow read, write: if isSignedIn();
    }

    // 10. سجلات الإدارة والتدقيق والنسخ الاحتياطي
    match /audit_logs/{d} { allow read, write: if isStaff(); }
    match /admin_logs/{d} { allow read, write: if isStaff(); }
    match /system_logs/{d} { allow read, write: if isStaff(); }
    match /admin_audit_logs/{d} { allow read, write: if isStaff(); }
    match /security_audit_logs/{d} { allow read, write: if isStaff(); }
    match /system_stats/{d} { allow read, write: if isStaff(); }
    match /admin_notifications/{d} { allow read, write: if isStaff(); }
    match /admin_settings/{d} { allow read, write: if isStaff(); }
    match /database_backups/{d} { allow read, write: if isStaff(); }
    match /settings_backups/{d} { allow read, write: if isStaff(); }
    match /activity_logs/{d} {
      allow create: if isSignedIn();
      allow read, update, delete: if isStaff();
    }
    match /user_behavior_logs/{d} {
      allow create: if isSignedIn();
      allow read, update, delete: if isStaff();
    }

    // 11. الحظر والرفض الافتراضي العام لجميع المجموعات الأخرى (Deny by default)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
