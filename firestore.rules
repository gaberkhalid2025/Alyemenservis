rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for security validation
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true || 
        get(/databases/$(database)/documents/registered_users/$(request.auth.uid)).data.role == "ADMIN"
      );
    }

    // Public / App Settings (Read-only for public, Write for Admin)
    match /settings/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin & Owner Isolated Settings - Strictly Restricted
    match /admin_settings/{document} {
      allow read, write: if isAdmin();
    }
    match /owner_settings/{document} {
      allow read, write: if isAdmin();
    }

    // Registered Users - Only own document or Admin
    match /registered_users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() || request.resource.data.keys().hasAll(['id', 'phone']);
      allow update, delete: if isOwner(userId) || isAdmin();
    }

    // Providers & Service Providers
    match /providers/{providerId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isOwner(providerId) || isAdmin();
    }

    match /pending_providers/{providerId} {
      allow read, write: if isAuthenticated();
    }

    // Stores & Commercial Directory
    match /stores/{storeId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isOwner(storeId) || isAdmin();
    }

    // Real Estate Properties
    match /properties/{propId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isOwner(propId) || isAdmin();
    }

    // Bookings & Maintenance Orders
    match /bookings/{bookingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        resource.data.providerId == request.auth.uid || 
        isAdmin()
      );
    }

    // Chats & Messages
    match /chats/{chatId} {
      allow read, write: if isAuthenticated();
    }

    // Complaints & Reports
    match /complaints/{complaintId} {
      allow read, write: if isAuthenticated();
    }

    // Internal Wallets & Transactions - Only owner or Admin
    match /internal_wallets/{walletId} {
      allow read, write: if isAuthenticated();
    }
    match /wallet_transactions/{txId} {
      allow read, write: if isAuthenticated();
    }

    // Default deny all unhandled paths
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
