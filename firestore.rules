rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== دالة مساعدة للتحقق من الأدمن =====
    function isAdmin() {
      return request.auth != null && 
             get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['admin', 'owner'];
    }

    // ===== دالة مساعدة للتحقق من صاحب الطلب =====
    function isOwner(phone) {
      return request.auth != null && 
             request.auth.token.phone_number == phone;
    }

    // ===== join_requests =====
    match /join_requests/{requestId} {
      // القراءة: صاحب الطلب أو الأدمن فقط
      allow read: if isAdmin() || 
                     (request.auth != null && resource.data.phone == request.auth.token.phone_number);
      
      // الإنشاء: أي مستخدم مسجل يمكنه إنشاء طلب بحالة PENDING فقط
      allow create: if request.auth != null && 
                       request.resource.data.status == "PENDING" &&
                       request.resource.data.approvalStatus == "PENDING";
      
      // التحديث: الأدمن فقط يمكنه تغيير الحالة إلى APPROVED أو REJECTED
      allow update: if isAdmin() || 
                       (request.auth != null && 
                        resource.data.phone == request.auth.token.phone_number &&
                        request.resource.data.status == resource.data.status); // صاحب الطلب لا يغير الحالة
      
      // الحذف: الأدمن فقط
      allow delete: if isAdmin();
    }

    // ===== providers / stores / properties / jobs =====
    match /providers/{providerId} {
      allow read: if true; // عام للقراءة
      allow write: if isAdmin(); // الكتابة للأدمن فقط بعد الموافقة
    }
    
    match /stores/{storeId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /properties/{propertyId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /jobs/{jobId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow read: if true;
      allow write: if isAdmin() || (request.auth != null && request.auth.uid == userId);
    }

    // ===== notifications =====
    match /notifications/{notificationId} {
      allow read: if isAdmin() || 
                     (request.auth != null && resource.data.targetValue == request.auth.token.phone_number);
      allow create: if isAdmin() || request.auth != null;
      allow update: if isAdmin() || 
                       (request.auth != null && resource.data.targetValue == request.auth.token.phone_number);
      allow delete: if isAdmin();
    }

    // ===== fcm_tokens =====
    match /fcm_tokens/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ===== admins =====
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // General fallback
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
