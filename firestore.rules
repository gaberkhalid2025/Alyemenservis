rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    
    // 1. المتاجر ومزودي الخدمات والعقارات (قراءة عامة للكل، وتعديل للمالك أو الإدارة)
    match /stores/{d} {
      allow read: if true;
      allow create, delete: if request.auth != null && request.auth.token.role in ['SUPER_ADMIN', 'MAIN_ADMIN', 'OWNER', 'ADMIN'];
      allow update: if request.auth != null
                  && (resource.data.ownerId == request.auth.uid
                      || request.auth.token.role in ['SUPER_ADMIN', 'MAIN_ADMIN', 'OWNER', 'ADMIN']);
    }
    match /providers/{d} {
      allow read: if true;
      allow create, delete: if request.auth != null && request.auth.token.role in ['SUPER_ADMIN', 'MAIN_ADMIN', 'OWNER', 'ADMIN'];
      allow update: if request.auth != null
                  && (resource.data.ownerId == request.auth.uid
                      || request.auth.token.role in ['SUPER_ADMIN', 'MAIN_ADMIN', 'OWNER', 'ADMIN']);
    }
    match /properties/{d} {
      allow read: if true;
      allow create, delete: if request.auth != null && request.auth.token.role in ['SUPER_ADMIN', 'MAIN_ADMIN', 'OWNER', 'ADMIN'];
      allow update: if request.auth != null
                  && (resource.data.ownerId == request.auth.uid
                      || request.auth.token.role in ['SUPER_ADMIN', 'MAIN_ADMIN', 'OWNER', 'ADMIN']);
    }
    match /products/{d} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null
                  && (resource.data.storeId == request.auth.uid
                      || resource.data.ownerId == request.auth.uid
                      || request.auth.token.role in ['SUPER_ADMIN','MAIN_ADMIN']);
    }


    // 2. طلبات الانضمام المعلقة (كتابة للمستخدم المسجل، قراءة وكتابة للإدارة والمالك)
    match /join_requests/{d} {
      allow read: if request.auth != null && request.auth.token.role in ['SUPER_ADMIN', 'MAIN_ADMIN', 'OWNER', 'ADMIN'];
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.token.role in ['SUPER_ADMIN', 'MAIN_ADMIN', 'OWNER', 'ADMIN'];
    }

    // 3. مستخدمي الإدارة والمالك والمشرفين (ممنوع القراءة والكتابة والوصول السحابي المباشر منعاً تاماً)
    match /admin_users/{d} { allow read, write: if false; }
    match /admins/{d} { allow read, write: if false; }
    match /supervisors/{d} { allow read, write: if false; }

    // 4. الإعدادات العامة (قراءة للمستخدمين المسجلين، وتعديل للإدارة والمالك فقط)
    match /settings/{d} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.role in ['SUPER_ADMIN', 'MAIN_ADMIN', 'OWNER'];
    }

    // 5. الحجوزات والمحادثات والتقييمات
    match /bookings/{d} {
      allow read, write: if request.auth != null;
    }
    match /chat_channels/{d} {
      allow read, write: if request.auth != null;
    }
    match /messages/{d} {
      allow read, write: if request.auth != null;
    }
    match /reviews/{d} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /ratings/{d} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null
                && (resource.data.userId == request.auth.uid
                    || request.auth.token.role in ['SUPER_ADMIN','MAIN_ADMIN']);
    }

    // 6. الحظر والرفض الافتراضي العام لجميع المجموعات الأخرى (Deny by default)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
