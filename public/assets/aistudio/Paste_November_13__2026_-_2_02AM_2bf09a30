## 3) خريطة مناطق انقطاع الشبكة (تتعلمها من جهازك)
**صدق:** لا تعرف مناطق الانقطاع العامة (لا بيانات مشغلين مجانية)؛ هي **ما لاحظه جهازك** أثناء تنقلاتك (محلياً، لا تُرسل). كلما استعملت التطبيق ازدادت دقتها.
```kotlin
package com.example.utils

import android.content.Context
import org.json.JSONArray
import org.json.JSONObject
import kotlin.math.floor

object CoverageLog {
    private const val FILE = "coverage_log"; private const val KEY = "cells"
    private const val CELL = 0.005                 // ≈ 550 م
    private const val MAX_CELLS = 2000
    @Volatile private var lastSample = 0L
    @Volatile private var lastLat = 0.0; @Volatile private var lastLng = 0.0

    /** استدعها من مسار تحديث الموقع (MainViewModel) كل تحديث؛ تقيّد نفسها بـ20 ث و30 م. */
    @Synchronized fun sample(ctx: Context, lat: Double, lng: Double, hasInternet: Boolean) {
        val now = System.currentTimeMillis()
        if (!LandmarkAddress.isValid(lat, lng) || now - lastSample < 20_000L) return
        if (lastSample != 0L && HaversinePrecisionNavigator.calculateDistance(lat, lng, lastLat, lastLng) < 30.0) return
        lastSample = now; lastLat = lat; lastLng = lng
        val prefs = ctx.getSharedPreferences(FILE, Context.MODE_PRIVATE)
        val root = try { JSONObject(prefs.getString(KEY, "{}")) } catch (e: Exception) { JSONObject() }
        val k = "${floor(lat / CELL).toLong()}_${floor(lng / CELL).toLong()}"
        val c = root.optJSONObject(k) ?: JSONObject().put("ok", 0).put("bad", 0)
        c.put(if (hasInternet) "ok" else "bad", c.optInt(if (hasInternet) "ok" else "bad") + 1).put("t", now)
        root.put(k, c)
        if (root.length() > MAX_CELLS) {                                     // احذف الأقدم
            val oldest = root.keys().asSequence().minByOrNull { root.getJSONObject(it).optLong("t") }
            if (oldest != null) root.remove(oldest)
        }
        prefs.edit().putString(KEY, root.toString()).apply()
    }

    /** منطقة ميتة: لاحظنا انقطاعاً ≥ مرتين وأكثر من حالات الاتصال. */
    fun deadZones(ctx: Context): List<MapZone> {
        val root = try { JSONObject(ctx.getSharedPreferences(FILE, Context.MODE_PRIVATE).getString(KEY, "{}")) } catch (e: Exception) { return emptyList() }
        val out = mutableListOf<MapZone>()
        root.keys().forEach { k ->
            val c = root.getJSONObject(k)
            if (c.optInt("bad") >= 2 && c.optInt("bad") > c.optInt("ok")) {
                val (a, b) = k.split("_").map { it.toLong() }
                out.add(MapZone((a + 0.5) * CELL, (b + 0.5) * CELL, 350, "#A78BFA"))
            }
        }
        return out
    }
    fun clear(ctx: Context) { ctx.getSharedPreferences(FILE, Context.MODE_PRIVATE).edit().clear().apply() }
}
```
الاستدعاء داخل `MainViewModel.updateUserLocation`: `CoverageLog.sample(appContext, lat, lng, NetworkUtils.hasInternetTransport(appContext))` (داخل `try/catch`). و`coverageZones = remember(state.coverageEnabled) { if (state.coverageEnabled) CoverageLog.deadZones(context) else emptyList() }`. زر «مسح بيانات التغطية» في الإعدادات.
**ملاحظة:** حالة «بلا إنترنت» تُلتقط حين يكون التطبيق مفتوحاً؛ تغطية الشبكات الخلوية نفسها (إشارة بلا بيانات) غير مقاسة.

## 4) تنبيه صعوبة الطرق قبل دخولها أثناء الملاحة
```kotlin
object HazardAlerts {
    /** يعيد أقرب منطقة خطر ضمن المسافة، أو null. */
    fun nearest(lat: Double, lng: Double, zones: List<MapZone>, alertMeters: Double = 300.0): MapZone? =
        zones.filter { HaversinePrecisionNavigator.calculateDistance(lat, lng, it.lat, it.lng) <= it.radiusM + alertMeters }
             .minByOrNull { HaversinePrecisionNavigator.calculateDistance(lat, lng, it.lat, it.lng) }
}
```
