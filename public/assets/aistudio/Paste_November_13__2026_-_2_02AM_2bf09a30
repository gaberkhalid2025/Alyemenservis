## 5) تصدير GPX (مسار الرحلة ومسار الخطة)
```kotlin
package com.example.utils

import android.content.Context
import androidx.core.content.FileProvider
import java.io.File
import java.text.SimpleDateFormat
import java.util.Date
import java.util.Locale
import java.util.TimeZone

data class TrackPoint(val lat: Double, val lng: Double, val timeMs: Long)

object GpxWriter {
    private fun esc(s: String) = s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("\"", "&quot;")
    private val iso = SimpleDateFormat("yyyy-MM-dd'T'HH:mm:ss'Z'", Locale.US).apply { timeZone = TimeZone.getTimeZone("UTC") }

    fun track(name: String, pts: List<TrackPoint>): String = buildString {
        append("<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n")
        append("<gpx version=\"1.1\" creator=\"AlYemenServices\" xmlns=\"http://www.topografix.com/GPX/1/1\">\n")
        append("<trk><name>${esc(name)}</name><trkseg>\n")
        synchronized(iso) { pts.forEach { append("<trkpt lat=\"${"%.6f".format(Locale.US, it.lat)}\" lon=\"${"%.6f".format(Locale.US, it.lng)}\"><time>${iso.format(Date(it.timeMs))}</time></trkpt>\n") } }
        append("</trkseg></trk></gpx>")
    }

    /** مسار مخطّط (بلا أوقات). */
    fun route(name: String, coords: List<Pair<Double, Double>>): String = buildString {
        append("<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n")
        append("<gpx version=\"1.1\" creator=\"AlYemenServices\" xmlns=\"http://www.topografix.com/GPX/1/1\">\n<rte><name>${esc(name)}</name>\n")
        coords.forEach { append("<rtept lat=\"${"%.6f".format(Locale.US, it.first)}\" lon=\"${"%.6f".format(Locale.US, it.second)}\"/>\n") }
        append("</rte></gpx>")
    }

    /** يحفظ في cache/exports ويعيد Uri للمشاركة (يتطلب <cache-path name="exports" path="exports/"/> في file_paths.xml). */
    fun saveAndUri(context: Context, fileName: String, xml: String): android.net.Uri? = try {
        val dir = File(context.cacheDir, "exports").apply { mkdirs() }
        dir.listFiles()?.filter { System.currentTimeMillis() - it.lastModified() > 86_400_000L }?.forEach { it.delete() }   // نظّف الأقدم من يوم
        val f = File(dir, fileName.replace(Regex("[^A-Za-z0-9._-]"), "_"))
        f.writeText(xml, Charsets.UTF_8)
        FileProvider.getUriForFile(context, "${context.packageName}.fileprovider", f)
    } catch (e: Exception) { null }
}

/** مسجّل رحلة اختياري (خصوصية: يعمل فقط بتفعيل المستخدم). */
class TripRecorder {
    private val pts = ArrayList<TrackPoint>()
    var enabled = false
    fun add(lat: Double, lng: Double, now: Long = System.currentTimeMillis()) {
        if (!enabled || !LandmarkAddress.isValid(lat, lng) || pts.size >= 20_000) return
        val last = pts.lastOrNull()
        if (last != null && now - last.timeMs < 2_000L &&
            HaversinePrecisionNavigator.calculateDistance(last.lat, last.lng, lat, lng) < 5.0) return
        pts.add(TrackPoint(lat, lng, now))
    }
    fun snapshot(): List<TrackPoint> = pts.toList()
    fun clear() = pts.clear()
}
```
