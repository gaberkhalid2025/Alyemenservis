### ملف جديد: `com/example/utils/OverlayFeeds.kt` (Kotlin يجلب الزلازل والمطر)
```kotlin
package com.example.utils

import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.withContext
import org.json.JSONObject
import java.net.HttpURLConnection
import java.net.URL

data class Quake(val lat: Double, val lng: Double, val mag: Double, val place: String, val timeMs: Long)

object OverlayFeeds {
    private var quakesCache: Pair<Long, List<Quake>>? = null
    private var rainCache: Pair<Long, String>? = null

    private fun get(url: String): String? {
        var c: HttpURLConnection? = null
        return try {
            c = (URL(url).openConnection() as HttpURLConnection).apply {
                connectTimeout = 8_000; readTimeout = 12_000; setRequestProperty("User-Agent", "AlYemenServicesApp/1.0")
            }
            if (c.responseCode == 200) c.inputStream.bufferedReader().use { it.readText() } else null
        } catch (e: Exception) { null } finally { c?.disconnect() }
    }

    /** زلازل المنطقة (الجزيرة العربية وما حولها) آخر أسبوع، M≥2.5. كاش 10 دقائق. */
    suspend fun quakes(): List<Quake>? = withContext(Dispatchers.IO) {
        quakesCache?.let { (t, v) -> if (System.currentTimeMillis() - t < 10 * 60_000L) return@withContext v }
        val text = get(NavConfig.QUAKES_FEED_URL) ?: return@withContext null
        try {
            val feats = JSONObject(text).optJSONArray("features") ?: return@withContext emptyList()
            val out = mutableListOf<Quake>()
            for (i in 0 until feats.length()) {
                val f = feats.getJSONObject(i)
                val coords = f.optJSONObject("geometry")?.optJSONArray("coordinates") ?: continue
                val lng = coords.optDouble(0); val lat = coords.optDouble(1)
                if (lat !in 5.0..32.0 || lng !in 30.0..65.0) continue                  // نطاق المنطقة
                val p = f.optJSONObject("properties") ?: continue
                out.add(Quake(lat, lng, p.optDouble("mag", Double.NaN), p.optString("place"), p.optLong("time")))
            }
            val res = out.filter { !it.mag.isNaN() }.sortedByDescending { it.timeMs }.take(150)
            quakesCache = System.currentTimeMillis() to res
            res
        } catch (e: Exception) { null }
    }

    /** قالب بلاطات رادار المطر الأحدث (ماضٍ فقط). كاش 5 دقائق. null عند الفشل. */
    suspend fun rainTemplate(): String? = withContext(Dispatchers.IO) {
        if (!NavConfig.ENABLE_RAINVIEWER) return@withContext null
        rainCache?.let { (t, v) -> if (System.currentTimeMillis() - t < 5 * 60_000L) return@withContext v }
        val text = get("https://api.rainviewer.com/public/weather-maps.json") ?: return@withContext null
        try {
            val j = JSONObject(text)
            val host = j.optString("host")
            val past = j.optJSONObject("radar")?.optJSONArray("past") ?: return@withContext null
            if (past.length() == 0 || host.isBlank()) return@withContext null
            val path = past.getJSONObject(past.length() - 1).optString("path")
            val tpl = "$host$path/256/{z}/{x}/{y}/2/1_1.png"
            rainCache = System.currentTimeMillis() to tpl
            tpl
        } catch (e: Exception) { null }
    }
}
```
