## 6) طباعة/مشاركة ملخص المسار كـ PDF (رسم تخطيطي بلا إنترنت)
يرسم عنواناً وملخصاً وقائمة التعليمات ورسماً تخطيطياً للمسار (إسقاط بسيط) بلا بلاطات؛ يُشارك أو يُطبع من عارض PDF.
```kotlin
package com.example.utils

import android.content.Context
import android.graphics.Canvas
import android.graphics.Color
import android.graphics.Paint
import android.graphics.Path
import android.graphics.pdf.PdfDocument
import android.text.Layout
import android.text.StaticLayout
import android.text.TextPaint
import androidx.core.content.FileProvider
import java.io.File
import java.io.FileOutputStream
import kotlin.math.cos
import kotlin.math.max
import kotlin.math.min

object RoutePdfBuilder {
    private const val W = 595; private const val H = 842; private const val M = 36f

    fun build(context: Context, title: String, summary: String, steps: List<String>, coords: List<Pair<Double, Double>>): android.net.Uri? = try {
        val doc = PdfDocument()
        var pageNo = 1
        var page = doc.startPage(PdfDocument.PageInfo.Builder(W, H, pageNo).create())
        var canvas = page.canvas
        val titleP = TextPaint(Paint.ANTI_ALIAS_FLAG).apply { textSize = 20f; color = Color.BLACK; isFakeBoldText = true }
        val bodyP = TextPaint(Paint.ANTI_ALIAS_FLAG).apply { textSize = 12f; color = Color.DKGRAY }
        var y = M

        fun drawRtl(text: String, p: TextPaint, top: Float): Float {
            val layout = StaticLayout.Builder.obtain(text, 0, text.length, p, (W - 2 * M).toInt())
                .setAlignment(Layout.Alignment.ALIGN_OPPOSITE)            // يمين في النص العربي
                .setLineSpacing(0f, 1.15f).build()
            canvas.save(); canvas.translate(M, top); layout.draw(canvas); canvas.restore()
            return top + layout.height
        }
        y = drawRtl(title, titleP, y) + 8f
        y = drawRtl(summary, bodyP, y) + 14f

        // رسم تخطيطي للمسار
        if (coords.size >= 2) {
            val boxH = 220f; val box = android.graphics.RectF(M, y, W - M, y + boxH)
            val frame = Paint().apply { style = Paint.Style.STROKE; color = Color.LTGRAY }
            canvas.drawRect(box, frame)
            val minLat = coords.minOf { it.first }; val maxLat = coords.maxOf { it.first }
            val minLng = coords.minOf { it.second }; val maxLng = coords.maxOf { it.second }
            val kx = cos(Math.toRadians((minLat + maxLat) / 2))
            val w = max((maxLng - minLng) * kx, 1e-6); val h = max(maxLat - minLat, 1e-6)
            val s = min((box.width() - 20f) / w, (box.height() - 20f) / h).toFloat()
            fun px(lng: Double) = (box.left + 10f + ((lng - minLng) * kx * s)).toFloat()
            fun py(lat: Double) = (box.bottom - 10f - ((lat - minLat) * s)).toFloat()
            val path = Path().apply { coords.forEachIndexed { i, c -> if (i == 0) moveTo(px(c.second), py(c.first)) else lineTo(px(c.second), py(c.first)) } }
            canvas.drawPath(path, Paint(Paint.ANTI_ALIAS_FLAG).apply { style = Paint.Style.STROKE; strokeWidth = 3f; color = Color.rgb(0, 140, 200) })
            canvas.drawCircle(px(coords.first().second), py(coords.first().first), 6f, Paint().apply { color = Color.rgb(16, 185, 129) })
            canvas.drawCircle(px(coords.last().second), py(coords.last().first), 6f, Paint().apply { color = Color.rgb(220, 38, 38) })
            y = box.bottom + 16f
        }
        steps.forEachIndexed { i, s ->
            if (y > H - 80f) { doc.finishPage(page); pageNo++; page = doc.startPage(PdfDocument.PageInfo.Builder(W, H, pageNo).create()); canvas = page.canvas; y = M }
            y = drawRtl("${i + 1}. $s", bodyP, y) + 4f
        }
        doc.finishPage(page)
        val dir = File(context.cacheDir, "exports").apply { mkdirs() }
        val f = File(dir, "route_${System.currentTimeMillis()}.pdf")
        FileOutputStream(f).use { doc.writeTo(it) }
        doc.close()
        FileProvider.getUriForFile(context, "${context.packageName}.fileprovider", f)
    } catch (e: Exception) { null }
}
```
زر «PDF» في بطاقة الملاحة: `RoutePdfBuilder.build(context, "رحلتي إلى ${target.name}", "المسافة ${…} • الوقت ${…}${if (isApproximate) " (تقريبي)" else ""}", steps.map { it.instruction }, result.coordinates)` ثم مشاركة بـ`ACTION_SEND` (`application/pdf`). (يعمل أوفلاين تماماً؛ الرسم تخطيطي لا خريطة.)

