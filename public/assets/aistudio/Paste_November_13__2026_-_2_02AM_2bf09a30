## 8) فلتر كالمان ثنائي المحور (تنعيم الموقع)
يقلل ارتجاج GPS (وخصوصاً مع التشويش في اليمن) بفلترين مستقلين للشرق والشمال بالأمتار (فلا يحدث انجراف بين المحورين)، ويستعمل دقة كل قراءة كتباين للقياس.
```kotlin
package com.example.utils

import kotlin.math.cos
import kotlin.math.max

class LatLngKalman(private val processNoiseMps: Double = 3.0) {
    private class Axis { var x = Double.NaN; var p = 0.0
        fun update(z: Double, r: Double, dt: Double, q: Double): Double {
            if (x.isNaN()) { x = z; p = r; return x }
            p += q * q * dt                      // تنامي عدم اليقين مع الزمن
            val k = p / (p + r)
            x += k * (z - x); p *= (1 - k)
            return x
        } }
    private var originLat = Double.NaN; private var originLng = Double.NaN
    private var east = Axis(); private var north = Axis(); private var lastMs = 0L

    fun reset() { originLat = Double.NaN; east = Axis(); north = Axis(); lastMs = 0L }

    fun process(lat: Double, lng: Double, accuracyM: Float, timeMs: Long): Pair<Double, Double> {
        if (originLat.isNaN() || timeMs - lastMs > 10_000L) { reset(); originLat = lat; originLng = lng }
        val dt = if (lastMs == 0L) 0.0 else ((timeMs - lastMs).coerceAtLeast(0L)) / 1000.0
        lastMs = timeMs
        val mLat = 111_195.0; val mLng = 111_195.0 * cos(Math.toRadians(originLat))
        val r = max(accuracyM.toDouble(), 3.0).let { it * it }
        val e = east.update((lng - originLng) * mLng, r, dt, processNoiseMps)
        val n = north.update((lat - originLat) * mLat, r, dt, processNoiseMps)
        return (originLat + n / mLat) to (originLng + e / mLng)
    }
}
```
**التكامل** في `LocationService.locationUpdates` (قبل `trySend`):
```kotlin
val kalman = LatLngKalman()                 // خارج callback، داخل callbackFlow
// ... داخل onLocationResult بعد الفلاتر الحالية:
val (fl, fg) = kalman.process(loc.latitude, loc.longitude, if (loc.hasAccuracy()) loc.accuracy else 20f, loc.time)
trySend(LocationCoordinates(latitude = fl, longitude = fg, accuracyMeters = loc.accuracy, timestamp = loc.time))
```
**ضبط:** `processNoiseMps = 3.0` مناسب للسيارة؛ للمشي استعمل 1.0. القيم الأكبر تتبع الحركة بسرعة وتنعّم أقل. **اختبار JVM:**
```kotlin
class LatLngKalmanTest {
    @org.junit.Test fun noisyStationaryConverges() {
        val k = LatLngKalman(); val rnd = java.util.Random(1)
        var last = 0.0 to 0.0
        repeat(60) { i -> last = k.process(15.0 + rnd.nextGaussian() * 0.00005, 44.0 + rnd.nextGaussian() * 0.00005, 8f, 1000L * i) }
        org.junit.Assert.assertEquals(15.0, last.first, 0.00004); org.junit.Assert.assertEquals(44.0, last.second, 0.00004)
    }
    @org.junit.Test fun gapResets() {
        val k = LatLngKalman(); k.process(15.0, 44.0, 5f, 0L)
        val p = k.process(16.0, 45.0, 5f, 60_000L)        // فجوة > 10 ث: لا تنعيم عبر القفزة
        org.junit.Assert.assertEquals(16.0, p.first, 1e-6)
    }
}
```

## 9) «مجموعة»: تتبع أفراد العائلة/الفريق بتحديث يدوي
كل فرد يُنشئ رمز تتبع من جهازه (المستند 62) ويرسله؛ المجموعة تحفظ الرموز محلياً وتقرأها بـ`get()` عند الضغط على «تحديث» (≤ 5 أشخاص، مهلة 20 ث).
```kotlin
data class GroupMember(val label: String, val token: String)

class GroupStore(context: android.content.Context) {
    private val prefs = context.applicationContext.getSharedPreferences("group_tracking", android.content.Context.MODE_PRIVATE)
    fun all(): List<GroupMember> = try {
        val a = org.json.JSONArray(prefs.getString("m", "[]")); (0 until a.length()).map { GroupMember(a.getJSONObject(it).getString("l"), a.getJSONObject(it).getString("t")) }
    } catch (e: Exception) { emptyList() }
    fun add(label: String, token: String): Boolean {
        if (!TrackingShareManager.TOKEN_REGEX.matches(token) || label.isBlank()) return false
        val cur = all().filterNot { it.token == token }
        if (cur.size >= 5) return false
        save(cur + GroupMember(label.take(20), token)); return true
    }
    fun remove(token: String) = save(all().filterNot { it.token == token })
    private fun save(l: List<GroupMember>) {
        val a = org.json.JSONArray(); l.forEach { a.put(org.json.JSONObject().put("l", it.label).put("t", it.token)) }
        prefs.edit().putString("m", a.toString()).apply()
    }
}
// عند «تحديث»: val snaps = members.map { it to TrackingShareManager.fetch(db, it.token) }   // 5 قراءات كحد أقصى
// الخريطة: waypointMarkers = snaps.mapNotNull { (m, s) -> s?.let { Triple(m.label, it.lat, it.lng) } }
// عنصر منتهٍ (null) يُعرض «انتهت المشاركة» مع زر إزالة. لا مستمعين لحظيين.
```
**الخصوصية:** لا مشاركة بلا إنشاء الفرد نفسه الرمز، ويستطيع إيقافها فوراً (`revoke`).

